{
  "name": "void-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "_modules/*",
    "tooling/*"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24"
  },
  "scripts": {
    "audit": "bun audit",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "knip": "knip --no-progress"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "turbo": "^2.11.7"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "browserslist": "4.28.8",
    "devalue": "5.9.4",
    "dompurify": "3.4.16",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.8",
    "fflate": "0.4.9",
    "js-yaml": "4.3.2",
    "nanoid": "5.1.16",
    "postcss": "8.5.25",
    "qs": "6.16.0",
    "sharp": "0.35.5",
    "undici": "7.30.0",
    "uuid": "11.1.1",
    "vite": "8.1.5",
    "http-cache-semantics": "4.3.0"
  }
}
