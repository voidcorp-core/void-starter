# Pull from Vercel: vercel env pull .env.local
# DATABASE_URL is auto-injected by the Vercel + Neon Marketplace integration.
DATABASE_URL=postgres://<user>:<password>@<host>/<db>?sslmode=require

BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
AUTH_BOOTSTRAP_ADMIN_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Google OAuth (opt-in, see ADR 31). Email/password and magic link
# work without these. The provider is registered only when BOTH are set.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Resend authentication email
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_APP_NAME=void-starter
